COAL_BACKWARD_COMPATIBILITY_WITH_HPP_FCL:BOOL=OFF

//Build with tracy profiler for performance analysis
COAL_BUILD_WITH_TRACY:BOOL=OFF

//Activate logging for warnings or error messages. Turned on by
// default in Debug.
COAL_ENABLE_LOGGING:BOOL=OFF

//use qhull library to compute convex hulls.
